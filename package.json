{
  "name": "@mininglamp-oss/codex-channel-octo",
  "version": "0.1.0",
  "description": "Bridge OpenAI Codex (via @openai/codex-sdk) to Octo IM \u2014 independent Node.js gateway",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codex-channel-octo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "config.example.json",
    "config.bot.example.json",
    "config.bot.docker.example.json",
    "docs/issue-26-safe-recovery.md",
    "docs/final-output-policy.md",
    "docs/private-diagnostics.md",
    "docs/session-continuity.md",
    "scripts/check-codex-runtime.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mininglamp-OSS/codex-channel-octo.git"
  },
  "homepage": "https://github.com/Mininglamp-OSS/codex-channel-octo#readme",
  "bugs": {
    "url": "https://github.com/Mininglamp-OSS/codex-channel-octo/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs'); fs.copyFileSync('src/codex-jsonl-proxy.mjs', 'dist/codex-jsonl-proxy.mjs'); fs.chmodSync('dist/codex-jsonl-proxy.mjs', 0o755)\"",
    "dev": "npm run build && tsc --watch",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "type-check:mention-tests": "tsc --project tsconfig.mention-tests.json",
    "lint": "eslint src/ scripts/ --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check:recovery-tests": "tsc --project tsconfig.recovery-tests.json",
    "type-check:continuity-tests": "tsc --project tsconfig.continuity-tests.json",
    "runtime:check": "node scripts/check-codex-runtime.mjs",
    "runtime:update": "npm update @openai/codex-sdk && npm run runtime:check",
    "test:real-binary": "node scripts/ci/run-runner.mjs real-binary -c test/real-binary/vitest.config.ts",
    "test:parity-matrix": "node scripts/ci/parity-matrix-gate.mjs",
    "test:goldens": "node scripts/ci/run-runner.mjs goldens test/goldens",
    "goldens:verify": "node scripts/goldens/gen-b.mjs --check && node scripts/goldens/gen-oc-schedule.mjs --check",
    "test:downgrade": "node scripts/ci/run-runner.mjs downgrade test/downgrade",
    "test:integration": "node scripts/ci/run-runner.mjs integration test/integration test/harness test/seams",
    "test:egress": "node scripts/egress-bypass-scan.mjs && node scripts/ci/run-runner.mjs egress test/egress",
    "test:manifest": "node scripts/manifest/lint.mjs && node scripts/ci/run-runner.mjs manifest test/manifest test/oracle",
    "test:unit-records": "node scripts/ci/run-runner.mjs unit",
    "check:src-scope": "node scripts/ci/check-src-diff.mjs",
    "build:test": "tsc -p tsconfig.test-hooks.json",
    "pack:smoke": "node scripts/ci/pack-smoke.mjs",
    "test:mutation": "node scripts/ci/mutation-check.mjs",
    "type-check:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@openai/codex-sdk": "latest",
    "better-sqlite3": "^12.10.0",
    "crypto-js": "^4.2.0",
    "curve25519-js": "^0.0.4",
    "md5-typescript": "^1.0.5",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "globals": "^14.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "croner": "10.0.1",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "codex-contract-cli": "npm:@openai/codex@0.142.3"
  },
  "engines": {
    "node": ">=22"
  }
}
